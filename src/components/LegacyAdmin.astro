---
/**
 * Menampilkan halaman Alpine lama (quiz, timer) yang disimpan sebagai HTML mentah di src/legacy.
 * Marker: <!--ATTRS {...}-->, <!--STYLE-->…<!--/STYLE-->, <!--NAV-->, <!--HEADER-->, <!--FOOTER-->.
 * admin = true → dibungkus layout Panel Asisten (sidebar), navbar lama dibuang.
 */
import '../styles/global.css';
import '../styles/quiz.css';
import AdminLayout from '../layouts/AdminLayout.astro';

interface Props { html: string; title: string; admin?: boolean; active?: string; scripts?: string[]; sebelum?: string }
const { html, title, admin = false, active, scripts = [], sebelum = '' } = Astro.props;

const attrJson = html.match(/<!--ATTRS (.*?) -->/)?.[1] ?? '""';
const attrStr: string = JSON.parse(attrJson);
const attrs: Record<string, string> = {};
for (const m of attrStr.matchAll(/([\w:@.-]+)(?:="([^"]*)")?/g)) attrs[m[1]] = m[2] ?? '';
const style = html.match(/<!--STYLE-->([\s\S]*?)<!--\/STYLE-->/)?.[1] ?? '';
const body = html.replace(/<!--ATTRS .*? -->/, '').replace(/<!--STYLE-->[\s\S]*?<!--\/STYLE-->/, '').replace('<!--NAV-->', '');

const [awal, setelahHeader = ''] = body.includes('<!--HEADER-->') ? body.split('<!--HEADER-->') : ['', body];
const [tengah, akhir = ''] = setelahHeader.includes('<!--FOOTER-->') ? setelahHeader.split('<!--FOOTER-->') : [setelahHeader, ''];
const pakaiHeader = body.includes('<!--HEADER-->');
const pakaiFooter = body.includes('<!--FOOTER-->');
---
<AdminLayout title={title} active={active} alpine flush scripts={scripts}>
  <Fragment slot="head" set:html={style} />
  <div {...attrs} class={`${attrs.class ?? ''} !min-h-0`}>
    <Fragment set:html={sebelum} />
    <Fragment set:html={awal + tengah + akhir} />
  </div>
</AdminLayout>
