---
import Icon from './Icon.astro';
interface Props { active?: string }
const { active = '' } = Astro.props;
const { settings } = Astro.locals;

const menu = [
  { key: 'upload', href: '/', label: 'Upload Tugas', icon: 'upload' },
  { key: 'materi', href: '/materi', label: 'Download Materi', icon: 'download' },
  { key: 'screentask', href: settings.screenTaskUrl, label: 'ScreenTask Dosen', icon: 'screen', external: true },
  { key: 'kontrak', href: '/kontrak', label: 'Kontrak Tempat Duduk', icon: 'seat' },
  { key: 'quiz', href: '/quiz', label: 'Quiz', icon: 'quiz' },
] as const;


const linkCls = (k: string) =>
  k === active
    ? 'bg-blue-600/10 text-blue-600 dark:bg-blue-400/10 dark:text-blue-400 border-blue-500/20 shadow-sm'
    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100/70 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-gray-800/60 border-transparent';
---
<header class="sticky top-0 z-50 w-full px-3 sm:px-6 lg:px-8 pt-3 sm:pt-4 print:hidden">
  <nav class="max-w-7xl mx-auto bg-white/80 dark:bg-gray-900/85 backdrop-blur-md border border-gray-200/50 dark:border-gray-800/60 rounded-[1.5rem] shadow-[0_4px_30px_rgba(0,0,0,0.03)]">
    <div class="flex items-center justify-between h-16 gap-3 px-4 sm:px-6">
      <a href="/" class="shrink-0"><img class="h-9 sm:h-10 w-auto object-contain hover:scale-105 transition-transform" src="/img/lab-saql.webp" alt="SAQ Lab" /></a>

      <div class="hidden lg:flex items-center gap-1">
        {menu.map((m) => (
          <a href={m.href} target={'external' in m ? '_blank' : undefined} rel={'external' in m ? 'noopener' : undefined}
            class:list={['border px-3 py-1.5 rounded-xl text-[13px] font-semibold transition-all inline-flex items-center gap-1.5', linkCls(m.key)]}>
            <Icon name={m.icon} />{m.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <button type="button" data-theme-toggle class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700 text-xs font-semibold text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer" aria-label="Ganti tema">
          <span class="dark:hidden inline-flex items-center gap-1.5"><Icon name="moon" /> <span class="hidden sm:inline">Mode Gelap</span></span>
          <span class="hidden dark:inline-flex items-center gap-1.5"><Icon name="sun" /> <span class="hidden sm:inline">Mode Terang</span></span>
        </button>
        <details class="lg:hidden relative" data-dropdown>
          <summary class="list-none cursor-pointer p-2 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300" aria-label="Menu"><Icon name="menu" class="w-5 h-5" /></summary>
          <div class="absolute right-0 mt-2 w-72 max-h-[75vh] overflow-y-auto p-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-xl">
            {menu.map((m) => (
              <a href={m.href} target={'external' in m ? '_blank' : undefined} class:list={['flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold', m.key === active ? 'bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-400' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800']}>
                <Icon name={m.icon} />{m.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>
