---
import { DatabaseSync } from 'node:sqlite';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { all, get } from '../../lib/db';
import { DB_PATH } from '../../lib/config';

interface Obj { name: string; type: 'table' | 'view'; sql: string }
const objek = all<Obj>("SELECT name, type, sql FROM sqlite_master WHERE type IN ('table','view') AND name NOT LIKE 'sqlite_%' ORDER BY type DESC, name");
const KET: Record<string, string> = {
  v_jadwal: 'Jadwal lengkap per semester: hari, jam, mata kuliah, dosen, kelas, SKS, asisten PJ & 1–3.',
  v_pengumpulan: 'Tugas mahasiswa digabung dengan kelas, mata kuliah, dosen, dan tugas/pertemuan.',
  v_kontrak: 'Kursi kontrak per kelas beserta NIM & nama.',
  semester: 'Daftar semester; hanya satu yang aktif.', jadwal: 'Satu baris = satu kelas praktikum di satu semester.',
  jadwal_asisten: 'Asisten per jadwal (urutan 0 = PJ, 1–3 = asisten).', jadwal_pengganti: 'Kelas pengganti / pindah jam per tanggal.',
  asisten: 'Master asisten lab.', matkul: 'Master mata kuliah (nama + jurusan).', dosen: 'Master dosen pengampu.',
  kelas_tugas: 'Kelas upload tugas (otomatis dari jadwal, atau manual).', sesi_tugas: 'Tugas/pertemuan + deadline per kelas.',
  mahasiswa_kelas: 'Daftar mahasiswa per kelas (untuk "belum mengumpulkan").', submission: 'Satu kali pengumpulan tugas.',
  submission_file: 'File di dalam pengumpulan.', kontrak_kelas: 'Kelas kontrak tempat duduk.', kontrak_kursi: 'Kursi PC yang sudah dikontrak.',
  laporan_kerusakan: 'Laporan PC rusak.', materi_grup: 'Grup materi (matkul + dosen + kelas).', materi: 'File materi.',
  quiz: 'Quiz (soal disimpan sebagai JSON).', quiz_submission: 'Jawaban & nilai quiz.', settings: 'Pengaturan aplikasi.',
};
const info = objek.map((o) => ({
  ...o,
  rows: get<{ c: number }>(`SELECT COUNT(*) c FROM "${o.name}"`)!.c,
  kolom: all<{ name: string; type: string; pk: number; notnull: number }>(`PRAGMA table_info("${o.name}")`),
}));

const CONTOH = [
  { judul: 'Jadwal semester aktif', sql: 'SELECT hari, jam, mata_kuliah, jurusan, dosen, kelas, sks, asisten_pj\nFROM v_jadwal WHERE semester_aktif = 1;' },
  { judul: 'Dosen & mata kuliah yang diampu', sql: 'SELECT dosen, GROUP_CONCAT(DISTINCT mata_kuliah) AS mata_kuliah, COUNT(*) AS jumlah_kelas\nFROM v_jadwal WHERE semester_aktif = 1 GROUP BY dosen;' },
  { judul: 'Beban asisten per semester', sql: "SELECT a.nama, COUNT(*) AS kelas, SUM(x.urutan = 0) AS jadi_pj\nFROM jadwal_asisten x JOIN asisten a ON a.id = x.asisten_id\nJOIN jadwal j ON j.id = x.jadwal_id JOIN semester s ON s.id = j.semester_id\nWHERE s.aktif = 1 GROUP BY a.nama ORDER BY kelas DESC;" },
  { judul: 'Jumlah pengumpulan per kelas', sql: 'SELECT mata_kuliah, kelas, COUNT(*) AS upload, COUNT(DISTINCT nim) AS mahasiswa\nFROM v_pengumpulan GROUP BY mata_kuliah, kelas;' },
];

let sql = CONTOH[0].sql;
let hasil: Record<string, any>[] | null = null;
let galat = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  sql = String(f.get('sql') || '').trim();
  const bersih = sql.replace(/--.*$/gm, '').trim().replace(/;\s*$/, '');
  if (!/^(select|with|pragma\s+table_info|explain)\b/i.test(bersih) || bersih.includes(';')) {
    galat = 'Hanya satu perintah SELECT / WITH (baca saja) yang diizinkan di sini.';
  } else {
    const ro = new DatabaseSync(DB_PATH, { readOnly: true });
    try { hasil = (ro.prepare(bersih).all() as Record<string, any>[]).slice(0, 500); }
    catch (e: any) { galat = e.message; }
    finally { ro.close(); }
  }
}
const kolomHasil = hasil?.length ? Object.keys(hasil[0]) : [];
---
<AdminLayout title="Struktur Database" active="database" alpine width="full">
  <div class="max-w-[1500px] mx-auto grid xl:grid-cols-5 gap-6">
    <section class="xl:col-span-3 space-y-6">
      <form method="post" class="card p-5 space-y-3" x-data>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="font-extrabold flex items-center gap-2"><Icon name="search" /> Lihat data dengan SQL <span class="badge bg-emerald-100 text-emerald-700">baca saja</span></h2>
          <div class="flex flex-wrap gap-1.5">
            {CONTOH.map((c) => <button type="button" class="btn btn-sm btn-ghost" @click={`$refs.sql.value = ${JSON.stringify(c.sql)}`}>{c.judul}</button>)}
          </div>
        </div>
        <textarea name="sql" x-ref="sql" rows="5" class="input font-mono !text-xs" spellcheck="false">{sql}</textarea>
        <div class="flex items-center gap-3"><button class="btn btn-dark"><Icon name="check" /> Jalankan</button>
          <span class="text-xs text-gray-500">Data tidak bisa diubah dari sini. Maks. 500 baris ditampilkan.</span></div>
        {galat && <p class="p-3 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 text-sm font-mono">{galat}</p>}
      </form>
      {hasil && (
        <div class="card overflow-hidden">
          <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-700 text-sm font-bold">{hasil.length} baris</div>
          <div class="overflow-auto max-h-[60vh]">
            <table class="w-full text-xs">
              <thead class="bg-gray-50 dark:bg-gray-900 sticky top-0"><tr>{kolomHasil.map((k) => <th class="th whitespace-nowrap">{k}</th>)}</tr></thead>
              <tbody class="divide-y divide-gray-100 dark:divide-gray-700/60">
                {hasil.map((r) => <tr>{kolomHasil.map((k) => <td class="px-4 py-2 whitespace-nowrap max-w-xs truncate">{r[k] === null ? <span class="text-gray-400">NULL</span> : String(r[k])}</td>)}</tr>)}
              </tbody>
            </table>
          </div>
        </div>
      )}
      <div class="card p-5 text-sm text-gray-600 dark:text-gray-300 space-y-2">
        <h3 class="font-extrabold text-gray-900 dark:text-white">Membuka langsung di aplikasi SQL</h3>
        <p>Database berupa satu file SQLite: <code class="font-mono text-xs break-all">{DB_PATH}</code>. Bisa dibuka dengan <b>DB Browser for SQLite</b>, DBeaver, atau ekstensi SQLite di VS Code. View <code>v_jadwal</code>, <code>v_pengumpulan</code>, dan <code>v_kontrak</code> paling mudah dibaca.</p>
      </div>
    </section>

    <aside class="xl:col-span-2 space-y-3">
      <h2 class="font-extrabold px-1">Tabel & View ({info.length})</h2>
      {info.map((o) => (
        <details class="card group" open={o.name === 'v_jadwal'}>
          <summary class="list-none cursor-pointer px-4 py-3 flex items-center gap-2">
            <span class:list={['badge', o.type === 'view' ? 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300' : 'bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300']}>{o.type === 'view' ? 'VIEW' : 'TABEL'}</span>
            <span class="font-mono font-bold text-sm flex-1">{o.name}</span>
            <span class="text-xs text-gray-400">{o.rows} baris</span>
            <Icon name="chevron" class="w-4 h-4 text-gray-400 group-open:rotate-180 transition" />
          </summary>
          <div class="px-4 pb-4 text-xs">
            {KET[o.name] && <p class="text-gray-500 mb-2">{KET[o.name]}</p>}
            <div class="flex flex-wrap gap-1">
              {o.kolom.map((k) => <span class:list={['px-1.5 py-0.5 rounded font-mono', k.pk ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300' : 'bg-gray-100 dark:bg-gray-700']}>{k.name}{k.type ? <span class="text-gray-400"> {k.type.toLowerCase()}</span> : null}</span>)}
            </div>
          </div>
        </details>
      ))}
    </aside>
  </div>
</AdminLayout>
